+
+UA_GRID = ("Вежа, я Сокіл, квадрат тридцять один юніформ дельта квебек п'ять дев'ять сім вісім "
+           "нуль дев'ять три шість, прийом.")
+RU_DRONE = ("Башня, я Гранит, ждун, тридцать один юниформ дельта квебек пять девять семь восемь "
+            "ноль девять три шесть, приём.")
+FAR_GRID = ("Вежа, я Лис, квадрат один юніформ дельта квебек п'ять дев'ять сім вісім нуль дев'ять три шість, "
+            "біля Сараю, прийом.")          # zone 1 is the Pacific: misheard, so fall back to the landmark
+LANDMARK = "Вежа, я Граніт, сто метрів на схід від Сараю, прийом."
+
+FAKE = {
+    UA_GRID: dict(action="locate", landmark="unknown", relation="at", distance_m=0, callsign="Сокіл"),
+    RU_DRONE: dict(action="drone_sighting", landmark="unknown", relation="at", distance_m=0, callsign="Гранит",
+                   threat_word="ждун"),
+    FAR_GRID: dict(action="locate", landmark="Сарай", relation="at", distance_m=0, callsign="Лис"),
+    LANDMARK: dict(action="locate", landmark="Сарай", relation="east_of", distance_m=100, callsign="Граніт"),
+}
+
+
+async def fake_extract(transcript, *a, **k):
+    d = dict(bearing_override=None, tactical_confirmation="(read-back)", vague=False, threat_word=None,
+             count=1, another=False)
+    d.update(FAKE[transcript])
+    return SpatialIntent(**d)
+
+
+async def no_geocode(*a, **k):
+    return None
+
+
+main.extract_intent = fake_extract
+placement.geocode_landmark = no_geocode
+placement.find_nearest_generic_landmark = no_geocode
+client = TestClient(main.app)
+
+
+def post(text):
+    r = client.post("/api/process-text", json={"transcript": text})
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def test_spoken_ukrainian_grid_places_the_unit_on_the_grid():
+    e = post(UA_GRID)
+    assert e["status"] == "ok" and e["landmark_source"] == "grid"
+    assert e["mgrs"] == "31U DQ 5978 0936"
+    assert distance_km(tuple(e["resolved_coords"]), SARAI_GRID_CENTRE) * 1000 < 1
+    assert e["uncertainty_m"] == 7.1                      # half the diagonal of a 10 m square
+
+
+def test_drone_reported_by_grid_becomes_a_threat_marker_there():
+    e = post(RU_DRONE)
+    assert e["threat"] and e["landmark_source"] == "grid"
+    markers = client.get("/api/markers").json()
+    assert any(distance_km((m["lat"], m["lon"]), SARAI_GRID_CENTRE) * 1000 < 1 for m in markers)
+    # the speaker's own position must not move to the drone's grid
+    assert "Гранит" not in main.store.unit_positions() or main.store.units["Гранит"]["coords"] is None
+
+
+def test_far_away_grid_is_rejected_and_the_landmark_is_used():
+    e = post(FAR_GRID)
+    assert e["status"] == "ok" and e["landmark_source"] == "mission"
+    assert "rejected" in e["placement_method"] and "km from the area" in e["placement_method"]
+
+
+def test_every_position_gets_a_grid_no_finer_than_its_circle():
+    e = post(LANDMARK)
+    assert e["landmark_source"] == "mission" and e["mgrs"]
+    digits = len(e["mgrs"].split()[-1])                  # digits per axis
+    assert 10 ** (5 - digits) >= e["uncertainty_m"]
+
+
+if __name__ == "__main__":
+    for name, fn in list(globals().items()):
+        if name.startswith("test_"):
+            fn()
+            print("ok ", name)
