+@app.get("/api/markers")
+async def get_markers() -> list[dict]:
+    """Fused enemy / drone markers (one per object, not one per report)."""
+    now = time.time()
+    return [{
+        "id": m.id, "category": m.category, "lat": m.lat, "lon": m.lon,
+        "uncertainty_m": round(m.uncertainty_m), "count": m.count, "confidence": m.confidence,
+        "sources": [r for r, _ in m.sources],
+    } for m in store.fuser.markers(now=now)]
+
+
+async def process_transcript(transcript: str, pipeline_started: float) -> LocationEvent:
+    # Who is speaking decides whose memory we use.
+    stage_started = time.perf_counter()
+    guess = store.unit(store.callsign)
+    intent = await extract_intent(
+        transcript,
+        (guess["coords"] or DEMO_CENTER)[0],
+        (guess["coords"] or DEMO_CENTER)[1],
+        guess["last_landmark"],
+        guess["heading"],
+        store.callsign,
+    )
+    callsign = store.canonical(intent.callsign or store.callsign)
+    unit = store.unit(callsign)
+    speaker_known = unit["coords"] is not None
+    previous = unit["coords"] or DEMO_CENTER
+    logger.info("stage=extract callsign=%r landmark=%r relation=%r action=%r ms=%.1f", callsign,
+                intent.landmark, intent.relation, intent.action, (time.perf_counter() - stage_started) * 1000)
+
+    def make_event(**kw) -> LocationEvent:
+        return LocationEvent(id=str(uuid.uuid4()), timestamp=_utc_now(), transcript=transcript,
+                             intent=intent, callsign=callsign, **kw)
+
+    if intent.action == "stop" or not intent.landmark or intent.landmark.lower() in {"unknown", "none"}:
+        event = make_event(landmark_coords=None, resolved_coords=list(previous), status="ok",
+                           uncertainty_m=None if speaker_known else 500.0,
+                           placement_method="no landmark: last known position")
+    else:
+        stage_started = time.perf_counter()
+        landmark = await resolve_landmark_position(intent.landmark, callsign, previous,
+                                                   store.unit_positions(exclude=callsign))
+        logger.info("stage=geocode landmark=%r found=%s ms=%.1f", intent.landmark, landmark is not None,
+                    (time.perf_counter() - stage_started) * 1000)
+        if landmark is None:
+            event = make_event(landmark_coords=None, resolved_coords=None, status="error",
+                               error=f"Could not find landmark: {intent.landmark}")
+            store.add(event)
+            await store.broadcast(event)
+            return event
+
+        lat, lon, uncertainty, method = place(intent, landmark, previous, unit["heading"], speaker_known)
+        threat = fuse_threat(store, intent, callsign, lat, lon, uncertainty)
+        event = make_event(
+            landmark_coords=[landmark["lat"], landmark["lon"]], resolved_coords=[lat, lon], status="ok",
+            landmark_source=landmark.get("source"), landmark_name=landmark.get("name"),
+            uncertainty_m=round(uncertainty, 1), placement_method=method,
+            threat=Threat(**threat) if threat else None,
+        )
+
+    if intent.bearing_override is not None and intent.action in {"move", "locate"}:
+        unit["heading"] = intent.bearing_override
+    store.add(event)
+    await store.broadcast(event)
+    logger.info("stage=complete status=%s ms=%.1f", event.status, (time.perf_counter() - pipeline_started) * 1000)
+    return event
+
+
+def _pipeline_error(exc: Exception) -> HTTPException:
+    logger.exception("pipeline failed: %s", exc)
+    error_text = str(exc)
+    if "GEMINI_API_KEY is not configured" in error_text:
+        return HTTPException(status_code=503,
+                             detail="Gemini is not configured. Set a valid GEMINI_API_KEY in backend/.env.")
+    if "API_KEY_INVALID" in error_text or "invalid api key" in error_text.lower():
+        return HTTPException(status_code=502,
+                             detail="Gemini authentication failed. Replace GEMINI_API_KEY in backend/.env.")
+    return HTTPException(status_code=422, detail=f"Spatial intent processing failed: {exc}")
