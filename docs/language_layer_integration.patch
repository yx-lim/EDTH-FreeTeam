@@ -0,0 +1,51 @@
+"""Check the language datasets work together, without any audio or model.
+
+For every call in the test set it asks: if the system extracts the landmark
+correctly, does our alias table / mission points find the right place?
+And for drone calls: does the slang list recognise the drone?
+
+    python check_dataset.py           # uses dummy coordinates for empty mission points
+"""
+import csv
+
+try:
+    from .alias_lookup import MISSION_POINTS, _norm, resolve
+except ImportError:
+    from alias_lookup import MISSION_POINTS, _norm, resolve
+from threat_lookup import resolve_threat
+
+rows = list(csv.DictReader(open("voice_to_map_test_set.csv", encoding="utf-8")))
+
+# If mission points have no coordinates yet, use placeholders so the check can run.
+points = MISSION_POINTS
+if not points:
+    for r in csv.DictReader(open("mission_points.csv", encoding="utf-8")):
+        for name in [r["codename"]] + r["also_called"].split(";"):
+            if name.strip():
+                points[_norm(name.strip())] = (r["codename"], 0.0, 0.0)
+
+ok, problems, skipped = 0, [], 0
+for r in rows:
+    expected = r["landmark_osm_name"]
+    if expected.startswith("(") or expected.startswith("@grid"):
+        skipped += 1  # unit history or grid calls: checked by the pipeline, not here
+        continue
+    spoken_parts = [p.strip() for p in r["expected_landmark_spoken"].replace(" и ", " / ").replace(" і ", " / ").replace(" and ", " / ").split("/")]
+    expected_parts = [p.strip().replace("@mission:", "") for p in expected.split("+")]
+    results = [resolve(p, r["area"], points)["name"] for p in spoken_parts]
+    landmark_ok = all(any(res == exp for res in results) for exp in expected_parts)
+
+    drone_ok = True
+    if r["expected_action"] == "drone_sighting":
+        threat = resolve_threat(r["text_to_read"])
+        drone_ok = threat is not None
+    if landmark_ok and drone_ok:
+        ok += 1
+    else:
+        problems.append((r["id"], r["expected_landmark_spoken"], results, expected,
+                         "" if drone_ok else "drone word not recognised"))
+
+checked = len(rows) - skipped
+print(f"{ok}/{checked} calls resolve correctly ({skipped} skipped: unit history or grid)\n")
+for cid, spoken, got, exp, note in problems:
+    print(f"FAIL {cid}: said {spoken!r} -> got {got}, expected {exp} {note}")
diff --git a/backend/services/language/evaluate.py b/backend/services/language/evaluate.py
new file mode 100644
index 0000000..bf6b3d5
--- /dev/null
+++ b/backend/services/language/evaluate.py
@@ -0,0 +1,90 @@
+"""Score the pipeline against the test set and print the numbers for the pitch.
+
+1. Run every recording through the pipeline and save one JSON line per call to
+   predictions.jsonl, for example:
+   {"id": "UA01", "action": "position", "landmark": "Венсенський замок",
+    "relation": "north_of", "distance": 50, "lat": 48.8431, "lon": 2.4359}
+2. python evaluate.py              # practice calls (tune on these)
+   python evaluate.py heldout      # held-out calls: run ONCE on Sunday, the number for the slide
+"""
+import csv
+import json
+import math
+import statistics
+from collections import defaultdict
+
+try:
+    from .alias_lookup import resolve
+except ImportError:
+    from alias_lookup import resolve
+
+
+def haversine_m(lat1, lon1, lat2, lon2):
+    r = 6_371_000
+    p1, p2 = math.radians(lat1), math.radians(lat2)
+    dp, dl = p2 - p1, math.radians(lon2 - lon1)
+    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
+    return 2 * r * math.asin(math.sqrt(a))
+
+
+def landmark_ok(pred_landmark, row):
+    """Correct if the predicted landmark resolves to the same place as the expected one."""
+    if not pred_landmark:
+        return False
+    expected = row["landmark_osm_name"]
+    if expected.startswith("@mission:"):
+        expected = expected.split(":", 1)[1].split(" + ")[0]
+    got = resolve(pred_landmark, row["area"])["name"]
+    return got == expected or expected.startswith("(")  # "(unit history)" etc. not checked here
+
+
+def main(test_file="voice_to_map_test_set.csv", pred_file="predictions.jsonl", split="practice"):
+    truth = {r["id"]: r for r in csv.DictReader(open(test_file, encoding="utf-8"))
+             if split == "all" or r.get("split", "practice") == split}
+    print(f"Scoring {len(truth)} {split} calls\n")
+    preds = {}
+    with open(pred_file, encoding="utf-8") as f:
+        for line in f:
+            if line.strip():
+                p = json.loads(line)
+                preds[p["id"]] = p
+
+    stats = defaultdict(lambda: {"n": 0, "action": 0, "landmark": 0, "relation": 0,
+                                 "distance": 0, "all": 0, "errors": []})
+    for cid, row in truth.items():
+        for group in (row["lang"], "ALL"):
+            s = stats[group]
+            s["n"] += 1
+            p = preds.get(cid)
+            if not p:
+                continue
+            ok = {
+                "action": p.get("action") == row["expected_action"],
+                "landmark": landmark_ok(p.get("landmark"), row),
+                "relation": p.get("relation") == row["relation"],
+                "distance": abs(float(p.get("distance") or 0) - float(row["distance_m"] or 0)) <= 10,
+            }
+            for k, v in ok.items():
+                s[k] += v
+            s["all"] += all(ok.values())
+            if row["true_lat"] and p.get("lat") is not None:
+                s["errors"].append(haversine_m(float(row["true_lat"]), float(row["true_lon"]),
+                                               p["lat"], p["lon"]))
+
+    print(f"{'group':8} {'calls':>5} {'fully ok':>9} {'landmark':>9} {'relation':>9} "
+          f"{'distance':>9} {'median err':>11} {'within 50m':>11}")
+    for group in ["en", "uk", "ru", "mixed", "ALL"]:
+        s = stats.get(group)
+        if not s or not s["n"]:
+            continue
+        pct = lambda k: f"{100 * s[k] / s['n']:.0f}%"
+        errs = s["errors"]
+        med = f"{statistics.median(errs):.0f} m" if errs else "n/a"
+        w50 = f"{100 * sum(e <= 50 for e in errs) / len(errs):.0f}%" if errs else "n/a"
+        print(f"{group:8} {s['n']:>5} {pct('all'):>9} {pct('landmark'):>9} {pct('relation'):>9} "
+              f"{pct('distance'):>9} {med:>11} {w50:>11}")
+
+
+if __name__ == "__main__":
+    import sys
+    main(split=sys.argv[1] if len(sys.argv) > 1 else "practice")
diff --git a/backend/services/language/fetch_osm_landmarks.py b/backend/services/language/fetch_osm_landmarks.py
new file mode 100644
index 0000000..1deeb4b
--- /dev/null
+++ b/backend/services/language/fetch_osm_landmarks.py
@@ -0,0 +1,86 @@
+"""Download every named place in the demo areas from OpenStreetMap ONCE,
+save it to landmarks.csv, then run fully offline at the command post.
+
+Run on a laptop with internet (tonight):
+    pip install requests
+    python fetch_osm_landmarks.py
+
+Output: landmarks.csv  (name, name_uk, name_ru, name_en, kind, lat, lon, kind_of_shape, geometry, area)
+geometry is the full outline as JSON [[lat, lon], ...], used by geometry.py.
+The resolver can then look names up locally instead of calling Nominatim.
+"""
+import csv
+import json
+import time
+
+import requests
+
+OVERPASS = "https://overpass-api.de/api/interpreter"
+
+# south, west, north, east  (check these boxes on the map and widen if needed)
+AREAS = {
+    "Vincennes": (48.820, 2.400, 48.860, 2.480),      # town plus Bois de Vincennes
+    "Bila Tserkva": (49.770, 30.060, 49.830, 30.170),  # city centre and park
+}
+
+QUERY = """
+[out:json][timeout:90];
+(
+  node["name"]({s},{w},{n},{e});
+  way["name"]({s},{w},{n},{e});
+  relation["name"]["type"="multipolygon"]({s},{w},{n},{e});
+);
+out geom tags;
+"""
+
+KIND_KEYS = ["amenity", "historic", "leisure", "natural", "building", "railway",
+             "public_transport", "highway", "tourism", "landuse", "waterway", "man_made"]
+
+
+def fetch(area, box):
+    s, w, n, e = box
+    r = requests.post(OVERPASS, data={"data": QUERY.format(s=s, w=w, n=n, e=e)}, timeout=120)
+    r.raise_for_status()
+    rows = []
+    for el in r.json()["elements"]:
+        tags = el.get("tags", {})
+        # Keep the full shape, not just one point: big places need their edges.
+        if el["type"] == "node":
+            coords, kind = [(el["lat"], el["lon"])], "point"
+        elif "geometry" in el:
+            coords = [(g["lat"], g["lon"]) for g in el["geometry"]]
+            kind = "polygon" if len(coords) > 3 and coords[0] == coords[-1] else "line"
+        else:
+            continue  # relations without simple geometry are skipped for the demo
+        lat = sum(c[0] for c in coords) / len(coords)
+        lon = sum(c[1] for c in coords) / len(coords)
+        kind = next((f"{k}={tags[k]}" for k in KIND_KEYS if k in tags), "other")
+        rows.append({
+            "name": tags.get("name", ""),
+            "name_uk": tags.get("name:uk", ""),
+            "name_ru": tags.get("name:ru", ""),
+            "name_en": tags.get("name:en", ""),
+            "kind": kind,
+            "lat": round(lat, 6),
+            "lon": round(lon, 6),
+            "kind_of_shape": kind,
+            "geometry": json.dumps([[round(a, 6), round(b, 6)] for a, b in coords]),
+            "area": area,
+        })
+    return rows
+
+
+if __name__ == "__main__":
+    all_rows = []
+    for area, box in AREAS.items():
+        rows = fetch(area, box)
+        print(f"{area}: {len(rows)} named places "
+              f"({sum(1 for r in rows if r['name_uk'])} with a Ukrainian name, "
+              f"{sum(1 for r in rows if r['name_ru'])} with a Russian name)")
+        all_rows += rows
+        time.sleep(5)  # be polite to the public Overpass server
+    with open("landmarks.csv", "w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=list(all_rows[0].keys()))
+        writer.writeheader()
+        writer.writerows(all_rows)
+    print("Saved landmarks.csv")
diff --git a/backend/services/language/fuse.py b/backend/services/language/fuse.py
new file mode 100644
index 0000000..574f8cb
--- /dev/null
+++ b/backend/services/language/fuse.py
@@ -0,0 +1,173 @@
+"""Merge reports of the same enemy / drone from different units into one marker.
+
+Rule of thumb, as a commander would apply it:
+  Two reports are the SAME thing if
+    1. they are the same kind of thing (an FPV and a "drone" can match; an FPV and a Shahed cannot),
+    2. they came close in time (drones move fast, so their window is short),
+    3. they are close enough in place, allowing for each report's uncertainty
+       and for how far the thing could have moved in between.
+  Then: combine the positions (more precise report counts more), shrink the circle,
+  and record both sources. Two independent units seeing it = higher confidence.
+
+  Two identical drones close together (the dangerous case: merging them would make
+  the commander underestimate the threat). When unsure, KEEP THEM SEPARATE:
+    A. Counts: "два ждуни" -> count=2. A marker keeps the HIGHEST count any single
+       unit reported, so "Сокіл: два" + "Граніт: один" = at least 2, never 1.
+    B. "ще один / ещё один / another / другий" -> always a new marker, never an update.
+    C. Only clear matches merge. Borderline matches get their own marker, flagged
+       "possibly the same as #N", and the operator decides with one click.
+
+    from fuse import SightingFuser
+    f = SightingFuser()
+    f.add(reporter="Сокіл", category="fpv_ambush", lat=..., lon=..., uncertainty_m=40, t=1000)
+    f.markers()   # what the map should draw
+"""
+import math
+from dataclasses import dataclass, field
+
+# How fast each kind of thing can move (m/s) and how long a report stays "fresh" (s).
+PROFILES = {
+    "fpv":               (30, 90),
+    "fpv_fiber":         (25, 90),
+    "fpv_ambush":        (0.5, 1800),   # sits on the ground waiting
+    "recon_quad":        (15, 300),
+    "recon_fixed_wing":  (30, 300),
+    "loitering_munition": (40, 120),
+    "attack_fixed_wing": (30, 120),
+    "long_range_strike": (50, 120),
+    "bomber":            (15, 300),
+    "uav":               (25, 180),     # "пташка": type unknown
+    "infantry":          (2, 900),
+    "vehicle":           (15, 600),
+}
+
+# Which categories may be the same object (a vague report can match a specific one).
+COMPATIBLE = {
+    "uav": {"fpv", "fpv_fiber", "recon_quad", "bomber", "recon_fixed_wing", "uav"},
+    "fpv": {"fpv", "fpv_fiber", "uav"},
+    "fpv_fiber": {"fpv_fiber", "fpv", "uav"},
+}
+
+
+def _dist_m(lat1, lon1, lat2, lon2):
+    kx = 111_320 * math.cos(math.radians((lat1 + lat2) / 2))
+    return math.hypot((lon2 - lon1) * kx, (lat2 - lat1) * 110_540)
+
+
+def _compatible(a, b):
+    return a == b or b in COMPATIBLE.get(a, set()) or a in COMPATIBLE.get(b, set())
+
+
+MERGE_THRESHOLD = 0.5   # merge only if distance is under half of what is allowed
+
+
+@dataclass
+class Marker:
+    id: int
+    category: str
+    lat: float
+    lon: float
+    uncertainty_m: float
+    t_first: float
+    t_last: float
+    sources: list = field(default_factory=list)   # (reporter, time)
+    count: int = 1                                # how many objects (highest single report)
+    possibly_same_as: list = field(default_factory=list)
+
+    @property
+    def confidence(self):
+        n = len({r for r, _ in self.sources})
+        text = {1: "single report", 2: "confirmed by 2 units"}.get(n, f"confirmed by {n} units")
+        if self.possibly_same_as:
+            text += f", possibly same as #{', #'.join(map(str, self.possibly_same_as))}"
+        return text
+
+
+class SightingFuser:
+    def __init__(self):
+        self._markers: list[Marker] = []
+
+    def add(self, reporter, category, lat, lon, uncertainty_m, t, count=1, another=False):
+        """count: number of objects in this report ("два ждуни" -> 2).
+        another: the speaker said "ще один / ещё один / another"."""
+        best, best_score, borderline = None, None, []
+        for m in self._markers:
+            if not _compatible(m.category, category):
+                continue
+            speed, window = PROFILES.get(category, PROFILES["uav"])
+            dt = t - m.t_last
+            if dt < 0 or dt > window:
+                continue
+            allowed = m.uncertainty_m + uncertainty_m + speed * dt
+            d = _dist_m(m.lat, m.lon, lat, lon)
+            if d <= allowed:
+                score = d / allowed
+                if score <= MERGE_THRESHOLD and not another:
+                    if best_score is None or score < best_score:
+                        best, best_score = m, score
+                else:
+                    borderline.append(m.id)
+        if best is None:
+            m = Marker(len(self._markers) + 1, category, lat, lon, uncertainty_m, t, t,
+                       [(reporter, t)], count=count, possibly_same_as=[] if another else borderline)
+            self._markers.append(m)
+            if another:
+                return m, "new marker (speaker said 'another')"
+            return m, "new marker, flagged as possibly the same" if borderline else "new marker"
+
+        # Combine: the more precise report weighs more (inverse-variance weighting).
+        speed, _ = PROFILES.get(category, PROFILES["uav"])
+        old_u = best.uncertainty_m + speed * (t - best.t_last)  # older report has aged
+        w_old, w_new = 1 / old_u ** 2, 1 / uncertainty_m ** 2
+        best.lat = (best.lat * w_old + lat * w_new) / (w_old + w_new)
+        best.lon = (best.lon * w_old + lon * w_new) / (w_old + w_new)
+        best.uncertainty_m = 1 / math.sqrt(w_old + w_new)
+        best.t_last = t
+        # Keep the more specific type ("пташка" + "FPV" -> FPV).
+        if best.category == "uav" and category != "uav":
+            best.category = category
+        best.sources.append((reporter, t))
+        best.count = max(best.count, count)
+        same_reporter = any(r == reporter for r, _ in best.sources[:-1])
+        return best, "updated by same unit" if same_reporter else "merged with another unit's report"
+
+    def markers(self, now=None):
+        out = []
+        for m in self._markers:
+            if now is not None:
+                _, window = PROFILES.get(m.category, PROFILES["uav"])
+                if now - m.t_last > window:
+                    continue  # stale: stop drawing (or grey it out)
+            out.append(m)
+        return out
+
+
+if __name__ == "__main__":
+    f = SightingFuser()
+    lat0, lon0 = 48.8400, 2.4350
+    m_north = 1 / 110_540
+
+    steps = [
+        dict(reporter="Сокіл", category="fpv_ambush", lat=lat0, lon=lon0, uncertainty_m=40, t=1000),
+        dict(reporter="Граніт", category="fpv_ambush", lat=lat0 + 20 * m_north, lon=lon0, uncertainty_m=30, t=1030),
+        dict(reporter="Сокіл", category="fpv_ambush", lat=lat0 + 30 * m_north, lon=lon0, uncertainty_m=40, t=1050, another=True),
+        dict(reporter="Лис", category="fpv_ambush", lat=lat0 + 90 * m_north, lon=lon0, uncertainty_m=40, t=1060),
+        dict(reporter="Граніт", category="recon_quad", lat=lat0 + 500 * m_north, lon=lon0, uncertainty_m=50, t=1100, count=2),
+        dict(reporter="Лис", category="recon_quad", lat=lat0 + 510 * m_north, lon=lon0, uncertainty_m=50, t=1110, count=1),
+    ]
+    labels = [
+        "Сокіл: ждун near the barn",
+        "Граніт, 30 s later, 20 m away: clearly the same ждун",
+        "Сокіл: 'ще один ждун', 30 m away",
+        "Лис: a ждун 90 m away (borderline)",
+        "Граніт: 'два мавіки' 500 m north",
+        "Лис: 'мавік' there, 10 s later",
+    ]
+    for label, step in zip(labels, steps):
+        m, what = f.add(**step)
+        print(f"{label:52} -> #{m.id} {what}")
+
+    print("\nMap shows:")
+    for m in f.markers(now=1120):
+        print(f"  #{m.id} {m.category:12} x{m.count}  ±{m.uncertainty_m:3.0f} m  {m.confidence:40} "
+              f"sources: {', '.join(r for r, _ in m.sources)}")
diff --git a/backend/services/language/geometry.py b/backend/services/language/geometry.py
new file mode 100644
index 0000000..0869131
--- /dev/null
+++ b/backend/services/language/geometry.py
@@ -0,0 +1,123 @@
+"""Place a report correctly when the landmark is big (a forest, a lake) or long (a tree line, a road).
+
+The common mistake: "50 m north of the forest" computed from the forest's CENTRE,
+which can be a kilometre off. Instead:
+
+  * "north of X"  -> start from the edge of X on its north side, then go 50 m north.
+  * "in / at X"   -> if we know where the unit was, the point of X closest to it;
+                     otherwise X's centre, with an uncertainty circle as big as X.
+  * long things   -> same rules: a tree line is treated as a line, not a dot.
+
+Every result carries an uncertainty radius in metres, so the map draws a circle,
+not a falsely precise pin.
+
+    pip install shapely
+    from geometry import place_report
+    place_report(shape, relation="north_of", distance_m=50, last_position=(lat, lon))
+"""
+import math
+
+from shapely.geometry import LineString, Point, Polygon
+from shapely.ops import nearest_points
+
+BEARINGS = {"north_of": 0, "northeast_of": 45, "east_of": 90, "southeast_of": 135,
+            "south_of": 180, "southwest_of": 225, "west_of": 270, "northwest_of": 315}
+
+
+class LocalMetres:
+    """Flat x/y in metres around a reference point. Accurate enough within a few km."""
+
+    def __init__(self, lat0, lon0):
+        self.lat0, self.lon0 = lat0, lon0
+        self.kx = 111_320 * math.cos(math.radians(lat0))
+        self.ky = 110_540
+
+    def to_xy(self, lat, lon):
+        return ((lon - self.lon0) * self.kx, (lat - self.lat0) * self.ky)
+
+    def to_latlon(self, x, y):
+        return (self.lat0 + y / self.ky, self.lon0 + x / self.kx)
+
+
+def _shape_to_xy(coords, frame, kind):
+    pts = [frame.to_xy(lat, lon) for lat, lon in coords]
+    if kind == "point":
+        return Point(pts[0])
+    if kind == "line":
+        return LineString(pts)
+    return Polygon(pts)
+
+
+def size_m(shape) -> float:
+    """Rough size of a place: half its longest side, used as uncertainty."""
+    minx, miny, maxx, maxy = shape.bounds
+    return max(maxx - minx, maxy - miny) / 2
+
+
+def place_report(coords, kind, relation, distance_m=0, last_position=None,
+                 vague=False, bearing_deg=None):
+    """coords: list of (lat, lon); kind: 'point' | 'line' | 'polygon'.
+    relation can also be "bearing" with bearing_deg (from angles.py: clock, mils, half right).
+    Returns {'lat', 'lon', 'uncertainty_m', 'method'}."""
+    lat0, lon0 = coords[0]
+    frame = LocalMetres(lat0, lon0)
+    shape = _shape_to_xy(coords, frame, kind)
+    last_xy = Point(frame.to_xy(*last_position)) if last_position else None
+    base_uncertainty = 10.0
+
+    angle = bearing_deg if relation == "bearing" and bearing_deg is not None else BEARINGS.get(relation)
+    if angle is not None:
+        b = math.radians(angle)
+        dx, dy = math.sin(b), math.cos(b)
+        if kind == "point":
+            start, method = shape, "offset from point"
+        else:
+            # Edge point furthest in the requested direction.
+            boundary = shape if kind == "line" else shape.exterior
+            pts = [Point(c) for c in boundary.coords]
+            start = max(pts, key=lambda p: p.x * dx + p.y * dy)
+            method = "offset from the edge on that side"
+            if last_xy is not None:
+                # Prefer the edge point near the unit, if it is on the correct side.
+                near = nearest_points(boundary, last_xy)[0]
+                if (near.x - shape.centroid.x) * dx + (near.y - shape.centroid.y) * dy > 0:
+                    start, method = near, "offset from the edge nearest the unit"
+        x, y = start.x + dx * distance_m, start.y + dy * distance_m
+        uncertainty = base_uncertainty + 0.15 * distance_m
+        if kind != "point" and last_xy is None:
+            uncertainty += size_m(shape) * 0.3  # we don't know where along the edge
+    else:  # at / in / near / behind and unknown relations
+        if last_xy is not None and kind != "point":
+            p = nearest_points(shape if kind == "line" else shape.exterior, last_xy)[0]
+            x, y = p.x, p.y
+            uncertainty, method = base_uncertainty + 20, "closest part to the unit's last position"
+        else:
+            c = shape.centroid
+            x, y = c.x, c.y
+            uncertainty = base_uncertainty + (size_m(shape) if kind != "point" else 0)
+            method = "centre of the place, circle as big as the place"
+        if relation == "near":
+            uncertainty += 30
+
+    if vague:  # "метрів сто", "близько", "трохи далі"
+        uncertainty *= 1.5
+    lat, lon = frame.to_latlon(x, y)
+    return {"lat": round(lat, 6), "lon": round(lon, 6),
+            "uncertainty_m": round(uncertainty), "method": method}
+
+
+if __name__ == "__main__":
+    # A made-up 1 km x 600 m forest, and a 400 m tree line, for the self-test.
+    forest = [(48.830, 2.430), (48.830, 2.444), (48.8354, 2.444), (48.8354, 2.430), (48.830, 2.430)]
+    tree_line = [(48.840, 2.430), (48.840, 2.4355)]
+    centre_lat = (48.830 + 48.8354) / 2
+
+    r = place_report(forest, "polygon", "north_of", 50)
+    print("50 m north of forest       ->", r)
+    print("   the naive centre method would put it", round((48.8354 - centre_lat) * 110540), "m too far south")
+    print("north of forest, unit known ->", place_report(forest, "polygon", "north_of", 50,
+                                                          last_position=(48.8370, 2.4420)))
+    print("in the forest, unit unknown ->", place_report(forest, "polygon", "at"))
+    print("in the tree line, unit known->", place_report(tree_line, "line", "at",
+                                                          last_position=(48.8395, 2.4350)))
+    print("vague 'метрів сто' east     ->", place_report(tree_line, "line", "east_of", 100, vague=True))
