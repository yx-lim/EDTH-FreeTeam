+"""Turn drone and threat slang into a standard type for the map icon.
+
+    from threat_lookup import resolve_threat
+    resolve_threat("ждун")        # {'type': 'FPV drone waiting on the ground (ambush)', 'category': 'fpv_ambush', ...}
+    resolve_threat("фпв на оптиці")  # longest match wins -> fiber-optic FPV
+"""
+import csv
+from pathlib import Path
+
+try:
+    from .alias_lookup import _match, _norm
+except ImportError:
+    from alias_lookup import _match, _norm
+
+VOCAB_FILE = Path(__file__).with_name("threat_vocab.csv")
+
+
+def _load():
+    vocab = {}
+    with open(VOCAB_FILE, encoding="utf-8") as f:
+        for row in csv.DictReader(f):
+            vocab.setdefault(_norm(row["spoken"]), row)
+    return vocab
+
+
+VOCAB = _load()
+
+
+def resolve_threat(text: str):
+    hit = _match(text, VOCAB)
+    if not hit:
+        return None
+    row = VOCAB[hit]
+    return {"type": row["canonical_type"], "category": row["category"],
+            "matched": row["spoken"], "verified": row["source_status"] == "sourced"}
+
+
+if __name__ == "__main__":
+    for t in ["пташка над Ромашкою", "ждун біля Сараю", "орлан кружит", "фпв на оптиці",
+              "мавік висить", "мопед пройшов", "Баба Яга", "ланцета", "нічого"]:
+        print(f"{t!r:24} -> {resolve_threat(t)}")
