+"""End-to-end test of the backend with Gemini and Nominatim replaced by fakes."""
+import sys, types, asyncio
+import os; sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+# google.generativeai is not needed for the fake run
+sys.modules.setdefault("google", types.ModuleType("google"))
+sys.modules["google.generativeai"] = types.ModuleType("google.generativeai")
+
+from fastapi.testclient import TestClient
+import main
+from models import SpatialIntent
+import services.placement as placement
+
+FAKE = {
+ "Вежа, я Сокіл, сто метрів на схід від Сараю, прийом.":
+   dict(action="locate", landmark="Сарай", relation="east_of", distance_m=100, callsign="Сокіл", language="uk"),
+ "Башня, я Гранит, на Ромашке, вижу двоих, приём.":
+   dict(action="contact", landmark="Ромашка", relation="at", distance_m=0, callsign="Гранит", language="ru", count=2),
+ "Вежа, я Лис, ждун біля Сараю, метрів п'ятдесят на захід, не підходити, прийом.":
+   dict(action="drone_sighting", landmark="Сарай", relation="west_of", distance_m=50, callsign="Лис", language="uk", vague=True, threat_word="ждун"),
