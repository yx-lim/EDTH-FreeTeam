diff --git a/backend/services/language/radio_effect.py b/backend/services/language/radio_effect.py
new file mode 100644
index 0000000..b5320bf
--- /dev/null
+++ b/backend/services/language/radio_effect.py
@@ -0,0 +1,87 @@
+"""Make clean phone recordings sound like a tactical radio, so the test is honest.
+
+What it adds, like a real handheld net:
+  * narrow radio band (about 300 to 3000 Hz): voices sound thin and boxy
+  * light distortion from an overdriven mic
+  * background hiss, plus optional wind / engine rumble
+  * squelch: a short burst of static at the start and end of the transmission
+  * level "bad": stronger noise and a few dropouts, like a weak signal
+
+Usage (needs ffmpeg for .m4a / .mp3 input; .wav works without it):
+    pip install numpy scipy
+    python radio_effect.py recordings/            # writes recordings_radio/<name>_good.wav and _bad.wav
+    python radio_effect.py UA01.m4a               # one file
+
+Score the pipeline on both: clean, radio "good", radio "bad".
+The drop in accuracy between them is a useful honest number for the pitch.
+"""
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+from scipy.io import wavfile
+from scipy.signal import butter, sosfilt
+
+SR = 16_000  # Whisper works at 16 kHz
+
+
+def load(path: Path) -> np.ndarray:
+    """Any audio file -> mono float32 at 16 kHz."""
+    with tempfile.NamedTemporaryFile(suffix=".wav") as tmp:
+        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(path),
+                        "-ac", "1", "-ar", str(SR), tmp.name], check=True)
+        _, data = wavfile.read(tmp.name)
+    data = data.astype(np.float32)
+    return data / (np.max(np.abs(data)) + 1e-9)
+
+
+def bandpass(x, lo=300, hi=3000):
+    return sosfilt(butter(6, [lo, hi], btype="band", fs=SR, output="sos"), x)
+
+
+def lowpass(x, cutoff):
+    return sosfilt(butter(4, cutoff, btype="low", fs=SR, output="sos"), x)
+
+
+def squelch(rng, seconds=0.15, level=0.5):
+    n = int(SR * seconds)
+    burst = rng.normal(0, level, n) * np.linspace(1, 0, n)
+    return bandpass(burst, 500, 3000)
+
+
+def radio(x, quality="good", wind=True, seed=0):
+    rng = np.random.default_rng(seed)
+    noise_level = 0.03 if quality == "good" else 0.10
+
+    y = bandpass(x)
+    y = np.tanh(3.0 * y) / np.tanh(3.0)                      # overdriven mic
+    y = y + rng.normal(0, noise_level, len(y))                # hiss
+    if wind:
+        rumble = lowpass(rng.normal(0, 1, len(y)), 200)
+        y = y + 0.6 * noise_level * rumble / (np.max(np.abs(rumble)) + 1e-9) * 3
+    if quality == "bad":                                      # weak signal: short dropouts
+        for _ in range(max(1, len(y) // (SR * 2))):
+            start = rng.integers(0, max(1, len(y) - SR // 5))
+            y[start:start + rng.integers(SR // 20, SR // 6)] *= 0.05
+    y = np.concatenate([squelch(rng), y, squelch(rng, 0.1)])  # PTT click on and off
+    return (y / (np.max(np.abs(y)) + 1e-9) * 0.9).astype(np.float32)
+
+
+def process(path: Path, out_dir: Path):
+    x = load(path)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for quality in ("good", "bad"):
+        out = out_dir / f"{path.stem}_{quality}.wav"
+        wavfile.write(out, SR, (radio(x, quality) * 32767).astype(np.int16))
+        print("wrote", out)
+
+
+if __name__ == "__main__":
+    target = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+    exts = {".wav", ".m4a", ".mp3", ".ogg", ".opus", ".aac", ".flac"}
+    files = [target] if target.is_file() else sorted(p for p in target.iterdir() if p.suffix.lower() in exts)
+    out_dir = (target.parent if target.is_file() else target.parent) / f"{target.stem}_radio"
+    for f in files:
+        process(f, out_dir)
