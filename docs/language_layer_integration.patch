@@ -0,0 +1,161 @@
+"""Landmark resolution for Voice-to-Map (layer 3, before the Nominatim search).
+
+Order of lookup:
+  1. Mission reference points (unit codenames loaded before the patrol)
+     -> returns fixed coordinates, OSM is never asked.
+  2. Alias table (how people say a place -> its OSM name)
+     -> returns the OSM name to send to Nominatim.
+  3. Nothing matched -> returns the spoken text for Nominatim to try.
+
+Usage:
+    from alias_lookup import resolve
+    resolve("Ромашці")                 # {'source': 'mission', 'name': 'Ромашка', 'lat': .., 'lon': ..}
+    resolve("Венсенського замку")      # {'source': 'alias', 'name': 'Château de Vincennes'}
+    resolve("Notre-Dame")              # {'source': 'raw', 'name': 'Notre-Dame'}
+"""
+import csv
+import unicodedata
+from pathlib import Path
+
+HERE = Path(__file__).parent
+ALIAS_FILE = HERE / "landmark_aliases.csv"
+MISSION_FILE = HERE / "mission_points.csv"
+
+# Spoken numbers -> digits, so "орієнтир три" matches "Орієнтир 3".
+_NUMBERS = {
+    "один": "1", "одна": "1", "перший": "1", "первый": "1", "one": "1",
+    "два": "2", "дві": "2", "две": "2", "другий": "2", "второй": "2", "two": "2",
+    "три": "3", "третій": "3", "третий": "3", "three": "3",
+    "чотири": "4", "четыре": "4", "four": "4",
+    "пять": "5", "пять": "5", "five": "5",
+    "шість": "6", "шесть": "6", "six": "6",
+    "сім": "7", "семь": "7", "seven": "7",
+    "вісім": "8", "восемь": "8", "eight": "8",
+    "девять": "9", "nine": "9",
+    "десять": "10", "ten": "10",
+}
+
+
+_FOLD = str.maketrans({"і": "и", "ї": "и", "ы": "и", "є": "е", "э": "е", "ґ": "г", "ъ": "", "ь": ""})
+
+
+def _norm(text: str) -> str:
+    """Lowercase, strip accents, apostrophes and punctuation; spoken numbers to digits."""
+    text = text.lower().replace("'", "").replace("’", "").replace("ʼ", "")
+    words = []
+    for w in text.replace(",", " ").replace(".", " ").split():
+        w = _NUMBERS.get(w, w)
+        w = unicodedata.normalize("NFKD", w)
+        w = "".join(c for c in w if not unicodedata.combining(c))
+        # Fold Ukrainian and Russian letters together so "орієнтир" == "ориентир".
+        w = w.translate(_FOLD)
+        words.append(w)
+    return " ".join(words)
+
+
+def _same_word(a: str, b: str) -> bool:
+    """Ukrainian and Russian change endings by case ("замок" / "замку", "Ромашка" / "Ромашці").
+    Two words match if they share a long enough beginning."""
+    if a.isdigit() or b.isdigit() or min(len(a), len(b)) <= 3:
+        return a == b
+    common = 0
+    for x, y in zip(a, b):
+        if x != y:
+            break
+        common += 1
+    return common >= max(3, min(len(a), len(b)) - 3)
+
+
+def _match(spoken: str, candidates):
+    """Return the first candidate key that matches the spoken text, exact first, then fuzzy."""
+    key = _norm(spoken)
+    if key in candidates:
+        return key
+    words = key.split()
+    best = None
+    for cand in candidates:
+        cw = cand.split()
+        # The alias may sit inside a longer phrase: "Chateau de Vincennes main gate".
+        for start in range(len(words) - len(cw) + 1):
+            window = words[start:start + len(cw)]
+            if all(_same_word(a, b) for a, b in zip(cw, window)):
+                if best is None or len(cw) > len(best.split()):
+                    best = cand  # prefer the longest (most specific) alias
+                break
+    return best
+
+
+def _load_aliases():
+    table = {}
+    with open(ALIAS_FILE, encoding="utf-8") as f:
+        for row in csv.DictReader(f):
+            table.setdefault(row["area"], {}).setdefault(_norm(row["alias"]), row["osm_name"])
+    return table
+
+
+def load_mission_points(path=MISSION_FILE):
+    """Call again whenever the command post updates the reference list."""
+    points = {}
+    if Path(path).exists():
+        with open(path, encoding="utf-8") as f:
+            for row in csv.DictReader(f):
+                if row["lat"] and row["lon"]:
+                    value = (row["codename"], float(row["lat"]), float(row["lon"]))
+                    names = [row["codename"]] + [n for n in row.get("also_called", "").split(";") if n.strip()]
+                    for name in names:
+                        points[_norm(name.strip())] = value
+    return points
+
+
+_ALIASES = _load_aliases()
+MISSION_POINTS = load_mission_points()
+
+
+def resolve(spoken: str, area: str = "Vincennes", mission_points=None, unit_positions=None) -> dict:
+    """unit_positions: {callsign: (lat, lon, unix_time)} for anything that moves,
+    such as other patrols or a UAV ("300 метрів на північ від Птахи").
+    Feed it from your unit history, or straight from drone telemetry."""
+    if unit_positions:
+        units = {_norm(k): (k, *v) for k, v in unit_positions.items()}
+        hit = _match(spoken, units)
+        if hit:
+            name, lat, lon, ts = units[hit]
+            return {"source": "unit", "name": name, "lat": lat, "lon": lon, "as_of": ts}
+    points = MISSION_POINTS if mission_points is None else mission_points
+    hit = _match(spoken, points)
+    if hit:
+        name, lat, lon = points[hit]
+        return {"source": "mission", "name": name, "lat": lat, "lon": lon}
+    aliases = _ALIASES.get(area, {})
+    hit = _match(spoken, aliases)
+    if hit:
+        return {"source": "alias", "name": aliases[hit]}
+    return {"source": "raw", "name": spoken}
+
+
+def resolve_landmark(spoken: str, area: str = "Vincennes") -> str:
+    """Backwards compatible: just the name to search for."""
+    return resolve(spoken, area)["name"]
+
+
+if __name__ == "__main__":
+    demo_points = {  # dummy coordinates for the self-test only
+        _norm("Ромашка"): ("Ромашка", 48.0, 2.0),
+        _norm("Орієнтир 3"): ("Орієнтир 3", 48.1, 2.1),
+    }
+    tests = [
+        ("Ромашці", "Vincennes"),
+        ("Ромашкой", "Vincennes"),
+        ("орієнтир три", "Vincennes"),
+        ("ориентиру три", "Vincennes"),
+        ("Венсенського замку", "Vincennes"),
+        ("Цветочного парка", "Vincennes"),
+        ("the chateau", "Vincennes"),
+        ("собору", "Bila Tserkva"),
+        ("Торгових рядів", "Bila Tserkva"),
+        ("something unknown", "Vincennes"),
+    ]
+    demo_units = {"Птаха": (48.2, 2.2, 1732120000)}  # a UAV, updated from telemetry
+    tests += [("Птахи", "Vincennes"), ("от Птахи", "Vincennes")]
+    for spoken, area in tests:
+        print(f"{spoken!r:24} -> {resolve(spoken, area, demo_points, demo_units)}")
