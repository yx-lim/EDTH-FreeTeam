--- /dev/null
+++ b/backend/services/language/angles.py
@@ -0,0 +1,60 @@
+"""Turn spoken directions into a map bearing (degrees clockwise from north).
+
+Soldiers give direction in several systems. Mistral extracts the raw value,
+these functions turn it into a bearing the geometry engine can use.
+
+    clock_to_bearing(3, heading=90)      # "на 3 годині", walking east  -> 180 (south)
+    mils_to_degrees(1500, system="ua")   # "азимут 15-00" (6000 mils)  -> 90
+    mils_to_degrees(1600, system="nato") # 6400 mils                   -> 90
+    words_to_bearing("half right", heading=0) -> 45
+"""
+
+CARDINAL = {
+    "north": 0, "northeast": 45, "east": 90, "southeast": 135,
+    "south": 180, "southwest": 225, "west": 270, "northwest": 315,
+    "північ": 0, "північний схід": 45, "схід": 90, "південний схід": 135,
+    "південь": 180, "південний захід": 225, "захід": 270, "північний захід": 315,
+    "север": 0, "северо-восток": 45, "восток": 90, "юго-восток": 135,
+    "юг": 180, "юго-запад": 225, "запад": 270, "северо-запад": 315,
+}
+
+# Directions relative to the way the speaker is facing or moving.
+RELATIVE = {
+    "ahead": 0, "half right": 45, "right": 90, "behind": 180, "half left": 315, "left": 270,
+    "попереду": 0, "праворуч": 90, "позаду": 180, "ліворуч": 270,
+    "впереди": 0, "справа": 90, "сзади": 180, "слева": 270,
+}
+
+
+def clock_to_bearing(hour: float, heading: float) -> float:
+    """Clock method relative to the speaker: 12 o'clock is straight ahead, each hour is 30 degrees.
+    heading = the direction the speaker faces or moves (from unit history or the last report)."""
+    return (heading + (hour % 12) * 30) % 360
+
+
+def mils_to_degrees(mils: float, system: str = "ua") -> float:
+    """Angular mils. Soviet-legacy kit used by Ukrainian units divides a circle into 6000 (spoken
+    as "15-00" = 1500); NATO uses 6400. Mixing them up gives several degrees of error, which
+    becomes tens of metres at range. Check which system the unit uses."""
+    full_circle = 6000 if system == "ua" else 6400
+    return (mils / full_circle * 360) % 360
+
+
+def words_to_bearing(word: str, heading: float = 0.0):
+    """Cardinal words give an absolute bearing; relative words need the speaker's heading."""
+    w = word.lower().strip()
+    if w in CARDINAL:
+        return CARDINAL[w]
+    if w in RELATIVE:
+        return (heading + RELATIVE[w]) % 360
+    return None
+
+
+if __name__ == "__main__":
+    print("3 o'clock walking east ->", clock_to_bearing(3, heading=90))
+    print("9 o'clock walking north ->", clock_to_bearing(9, heading=0))
+    print("азимут 15-00 (UA 6000) ->", mils_to_degrees(1500, "ua"))
+    print("1600 mils (NATO 6400)  ->", mils_to_degrees(1600, "nato"))
+    print("1500 read as NATO by mistake ->", round(mils_to_degrees(1500, "nato"), 1), "degrees (off by 5.6)")
+    print("half right heading 0   ->", words_to_bearing("half right", 0))
+    print("праворуч heading 180   ->", words_to_bearing("праворуч", 180))
