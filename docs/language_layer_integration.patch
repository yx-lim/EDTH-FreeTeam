@@ -0,0 +1,40 @@
+import { useState } from "react";
+
+// Demo fallback: type or paste a radio report instead of speaking it.
+export default function TextReport({ onEvent, onError }) {
+  const [text, setText] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  const send = async () => {
+    if (!text.trim() || busy) return;
+    setBusy(true);
+    try {
+      const response = await fetch("http://127.0.0.1:8000/api/process-text", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ transcript: text }),
+      });
+      const payload = await response.json();
+      if (!response.ok) throw new Error(payload.detail || "Processing failed");
+      onEvent(payload);
+      setText("");
+    } catch (error) {
+      onError(error.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="text-report">
+      <input
+        value={text}
+        onChange={(e) => setText(e.target.value)}
+        onKeyDown={(e) => e.key === "Enter" && send()}
+        placeholder="Вежа, я Сокіл, сто метрів на схід від Сараю, прийом"
+        disabled={busy}
+      />
+      <button type="button" onClick={send} disabled={busy}>{busy ? "…" : "SEND"}</button>
+    </div>
+  );
+}
