+"""Glue between the API pipeline and the language layer.
+
+resolve_landmark_position(): spoken landmark -> coordinates (+ outline when OSM has one)
+place(): landmark + relation + distance -> final position with an honest uncertainty circle
+"""
+import time
+from typing import Any
+
+from config import DEMO_AREA
+from services.geocode import geocode_landmark
+from services.language.alias_lookup import resolve
+from services.language.fuse import PROFILES
+from services.language.geometry import BEARINGS, place_report
+from services.language.threat_lookup import resolve_threat
+from services.overpass import find_nearest_generic_landmark
+from services.spatial import calculate_relative_offset, calculate_towards_offset
+
+GENERIC = {
+    "church": "church", "церква": "church", "церковь": "church", "собор": "church",
+    "hospital": "hospital", "лікарня": "hospital", "больница": "hospital",
+    "school": "school", "школа": "school",
+    "bank": "bank", "банк": "bank",
+    "town hall": "town hall", "ратуша": "town hall", "мерія": "town hall", "мэрия": "town hall",
+}
+COMPASS = set(BEARINGS)                       # north_of ... northwest_of
+HEADING_RELATIVE = {"front_of": 0, "right_of": 90, "behind": 180, "left_of": 270}
+
+
+def _geojson_to_shape(geojson: dict | None):
+    """OSM GeoJSON (lon, lat) -> (coords as (lat, lon), kind) for geometry.place_report."""
+    if not geojson:
+        return None, None
+    gtype, coords = geojson.get("type"), geojson.get("coordinates")
+    try:
+        if gtype == "Polygon":
+            return [(c[1], c[0]) for c in coords[0]], "polygon"
+        if gtype == "MultiPolygon":
+            ring = max((poly[0] for poly in coords), key=len)
+            return [(c[1], c[0]) for c in ring], "polygon"
+        if gtype == "LineString":
+            return [(c[1], c[0]) for c in coords], "line"
+    except (TypeError, IndexError):
+        pass
+    return None, None
+
+
+async def resolve_landmark_position(landmark: str, speaker: str | None, previous: list[float],
+                                    unit_positions: dict) -> dict[str, Any] | None:
+    """Unit callsigns -> mission codenames -> alias table -> OSM (Nominatim) -> nearest generic POI."""
+    hit = resolve(landmark, area=DEMO_AREA, unit_positions=unit_positions)
+    if hit["source"] in ("mission", "unit"):
+        return {"lat": hit["lat"], "lon": hit["lon"], "geojson": None,
+                "source": hit["source"], "name": hit["name"]}
+
+    name = hit["name"]
+    result = await geocode_landmark(name, previous[0], previous[1])
+    if result is None:
+        generic = GENERIC.get(landmark.lower().strip()) or GENERIC.get(name.lower().strip())
+        if generic:
+            result = await find_nearest_generic_landmark(generic, previous[0], previous[1])
+    if result is None:
+        return None
+    result.update(source=hit["source"], name=name)
+    return result
+
+
+def place(intent, landmark: dict, previous: list[float], heading: float, speaker_known: bool):
+    """Return (lat, lon, uncertainty_m, method)."""
+    relation, dist = intent.relation, intent.distance_m
+    shape, kind = _geojson_to_shape(landmark.get("geojson"))
+    if shape is None:
+        shape, kind = [(landmark["lat"], landmark["lon"])], "point"
+    last = tuple(previous) if speaker_known else None
+
+    if relation == "towards":
+        lat, lon = calculate_towards_offset(previous[0], previous[1], (landmark["lat"], landmark["lon"]),
+                                            landmark.get("geojson"), dist)
+        return lat, lon, 15 + 0.2 * dist, "moving towards the landmark"
+
+    if intent.bearing_override is not None and relation not in COMPASS:
+        r = place_report(shape, kind, "bearing", dist, last, intent.vague, bearing_deg=intent.bearing_override)
+    elif relation in COMPASS:
+        r = place_report(shape, kind, relation, dist, last, intent.vague)
+    elif relation in HEADING_RELATIVE:
+        bearing = (heading + HEADING_RELATIVE[relation]) % 360
+        r = place_report(shape, kind, "bearing", dist, last, intent.vague, bearing_deg=bearing)
+        r["method"] += " (relative to the unit's heading)"
+    else:  # at, near, above
+        r = place_report(shape, kind, "near" if relation == "near" else "at", 0, last, intent.vague)
+    return r["lat"], r["lon"], r["uncertainty_m"], r["method"]
+
+
+def fuse_threat(store, intent, callsign: str, lat: float, lon: float, uncertainty: float):
+    """Turn a sighting into a fused map marker. Returns a dict for models.Threat, or None."""
+    threat = resolve_threat(intent.threat_word) if intent.threat_word else None
+    if threat is None and intent.action == "drone_sighting":
+        threat = {"type": "drone (type unknown)", "category": "uav", "matched": intent.threat_word or "", "verified": False}
+    if threat is None and intent.action == "contact":
+        threat = {"type": "enemy personnel", "category": "infantry", "matched": "", "verified": True}
+    if threat is None:
+        return None
+    category = threat["category"] if threat["category"] in PROFILES else "uav"
+    marker, what = store.fuser.add(callsign, category, lat, lon, max(uncertainty, 5), time.time(),
+                                   count=intent.count or 1, another=intent.another)
+    threat.update(marker_id=marker.id, count=marker.count, confidence=marker.confidence, fusion=what)
+    return threat
