From 18e21a9975b93c64032fc846276dec0f656a0400 Mon Sep 17 00:00:00 2001
From: Nikita Nedoshovenko <nikita.nedoshovenko@outlook.com>
Date: Sat, 21 Nov 2026 12:47:02 +0100
Subject: [PATCH 2/4] Codenames in another case are not mishearings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

'на Ромашці', 'біля Орієнтиру три', 'другої посадки' resolved to the right codename but were flagged
'sounds alike; confirm', so the commonest Ukrainian report arrived as a draft. A Cyrillic name only ever
reaches a place through the closed set of codenames and aliases, matched with case endings: no flag.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KG2RA2i89hGvASt44B7U7K
---
 tests/test_case_endings_not_doubt.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)
 create mode 100644 tests/test_case_endings_not_doubt.py

diff --git a/tests/test_case_endings_not_doubt.py b/tests/test_case_endings_not_doubt.py
new file mode 100644
index 0000000..23a5bda
--- /dev/null
+++ b/tests/test_case_endings_not_doubt.py
@@ -0,0 +1,20 @@
+"""A codename in another grammatical case is the same codename, not a mishearing: no "sounds alike; confirm"."""
+import asyncio
+
+import pytest
+
+from backend.geo import Gazetteer
+from backend.tracker import Tracker
+
+
+@pytest.mark.parametrize("line, anchor", [
+    ("Вежа, я Сокіл, на Ромашці, прийом.", "Ромашка"),
+    ("Вежа, я Лис, на Орієнтирі три, прийом.", "Орієнтир 3"),
+    ("Вежа, я Граніт, біля другої посадки, прийом.", "Друга посадка"),
+    ("Башня, я Лис, возле второй посадки, приём.", "Друга посадка"),
+])
+def test_inflected_codename_is_not_flagged(monkeypatch, line, anchor):
+    for key in ("GEMINI_API_KEY", "MISTRAL_API_KEY"):
+        monkeypatch.delenv(key, raising=False)
+    e = asyncio.run(Tracker(Gazetteer(), log=None).ingest(line, None, now=1e6))[0]
+    assert e["ok"] and e["anchor"] == anchor and not e["ambiguous"] and "sounds alike" not in (e.get("note") or "")
-- 
