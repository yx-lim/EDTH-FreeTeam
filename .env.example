# Copy to .env and fill in. Everything has an offline fallback:
#   no MISTRAL_API_KEY  -> rule-based extractor (English + French) and browser speech recognition
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Speech-to-text for push-to-talk clips: mistral | whisper | none (default: mistral if a key is set,
# else whisper if `pip install faster-whisper` has been run, else the browser's own recogniser).
STT_PROVIDER=
STT_MODEL=voxtral-mini-transcribe-3
WHISPER_MODEL=small
