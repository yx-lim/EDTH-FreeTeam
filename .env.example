# Copy to .env and fill in. Everything has an offline fallback:
#   no GEMINI_API_KEY / MISTRAL_API_KEY -> rule-based extractor
#   no ELEVENLABS_API_KEY / MISTRAL_API_KEY -> local Whisper (if installed), else the browser's speech recognition

# Report extraction: Gemini if its key is set, else Mistral. EXTRACTOR=gemini|mistral|rules forces one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EXTRACTOR=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Speech-to-text for push-to-talk clips: elevenlabs | gemini | mistral | whisper | none (default: elevenlabs, then mistral,
# whichever has a key, else whisper if `pip install faster-whisper` has been run, else the browser's own recogniser).
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
# GEMINI_STT_MODEL=   (defaults to GEMINI_MODEL)
# The app's speech dropdown overrides STT_PROVIDER until the backend restarts.
STT_MODEL=voxtral-mini-transcribe-3
WHISPER_MODEL=small
